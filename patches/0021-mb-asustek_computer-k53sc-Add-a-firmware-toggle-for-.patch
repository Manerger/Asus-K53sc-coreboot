From bd3ec6880999e0f20f843e8d81d947fee4b236cf Mon Sep 17 00:00:00 2001
From: manerger <filidog82@gmail.com>
Date: Fri, 28 Aug 2026 11:51:00 +0200
Subject: [PATCH 21/21] mb/asustek_computer/k53sc: Add a firmware toggle for
 the discrete GPU

The GeForce GT 520MX is useful but costs power, and there was no way to turn
it off short of rebuilding the firmware. Add a CMOS option so it can be
switched from a booted system.

The board had no option table at all (OPTION_BACKEND_NONE), so add cmos.layout
and cmos.default. Besides the dgpu entry they carry the standard console and
power_on_after_fail options, and the Sandy Bridge MRC scrambler seed slots,
which previously had nowhere to live.

Disabling works by clearing the PEG10 device from mainboard_enable(). Nothing
else is needed: sandybridge's disable_peg(), which runs later from
northbridge_init(), sees the inactive bridge and clears DEVEN_PEG10. The port
then disappears from PCI entirely rather than merely being hidden from the OS,
so the GPU draws no power.

Verified on hardware. With dgpu=Disable, both 01:00.0 (the GPU) and 00:01.0
(the PEG bridge) are absent from lspci; the IGD and the PCH root ports are
unaffected and the display is unchanged.

Toggle it with:
    nvramtool -w dgpu=Disable      (or Enable), then reboot

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/mainboard/asustek_computer/k53sc/Kconfig  |  2 +
 .../asustek_computer/k53sc/cmos.default       |  7 +++
 .../asustek_computer/k53sc/cmos.layout        | 63 +++++++++++++++++++
 .../asustek_computer/k53sc/mainboard.c        | 33 ++++++++++
 4 files changed, 105 insertions(+)
 create mode 100644 src/mainboard/asustek_computer/k53sc/cmos.default
 create mode 100644 src/mainboard/asustek_computer/k53sc/cmos.layout

diff --git a/src/mainboard/asustek_computer/k53sc/Kconfig b/src/mainboard/asustek_computer/k53sc/Kconfig
index 504b9bbe22..3499e80d43 100644
--- a/src/mainboard/asustek_computer/k53sc/Kconfig
+++ b/src/mainboard/asustek_computer/k53sc/Kconfig
@@ -19,6 +19,8 @@ config BOARD_SPECIFIC_OPTIONS
 	select SOUTHBRIDGE_INTEL_BD82X6X
 	select SYSTEM_TYPE_LAPTOP
 	select USE_NATIVE_RAMINIT
+	select HAVE_OPTION_TABLE
+	select HAVE_CMOS_DEFAULT
 
 config MAINBOARD_DIR
 	string
diff --git a/src/mainboard/asustek_computer/k53sc/cmos.default b/src/mainboard/asustek_computer/k53sc/cmos.default
new file mode 100644
index 0000000000..56c30cbf5f
--- /dev/null
+++ b/src/mainboard/asustek_computer/k53sc/cmos.default
@@ -0,0 +1,7 @@
+## SPDX-License-Identifier: GPL-2.0-only
+
+boot_option=Fallback
+debug_level=Debug
+power_on_after_fail=Disable
+nmi=Enable
+dgpu=Enable
diff --git a/src/mainboard/asustek_computer/k53sc/cmos.layout b/src/mainboard/asustek_computer/k53sc/cmos.layout
new file mode 100644
index 0000000000..ec2cc63da9
--- /dev/null
+++ b/src/mainboard/asustek_computer/k53sc/cmos.layout
@@ -0,0 +1,63 @@
+## SPDX-License-Identifier: GPL-2.0-only
+
+# -----------------------------------------------------------------
+entries
+
+# -----------------------------------------------------------------
+0	120	r	0	reserved_memory
+
+# -----------------------------------------------------------------
+# RTC_BOOT_BYTE (coreboot hardcoded)
+384	1	e	4	boot_option
+388	4	h	0	reboot_counter
+
+# -----------------------------------------------------------------
+# coreboot config options: console
+395	4	e	6	debug_level
+
+#400	8	r	0	reserved for century byte
+
+# coreboot config options: southbridge
+408	1	e	1	nmi
+409	2	e	7	power_on_after_fail
+
+# coreboot config options: northbridge
+# Discrete GeForce GT 520MX on PEG10. When disabled, mainboard_enable()
+# clears the device and sandybridge's disable_peg() then clears DEVEN_PEG10,
+# so the port disappears from PCI entirely rather than merely being hidden.
+411	1	e	1	dgpu
+
+# SandyBridge MRC Scrambler Seed values
+896	32	r	0	mrc_scrambler_seed
+928	32	r	0	mrc_scrambler_seed_s3
+960	16	r	0	mrc_scrambler_seed_chk
+
+# coreboot config options: check sums
+984	16	h	0	check_sum
+
+# -----------------------------------------------------------------
+
+enumerations
+
+#ID	value	text
+1	0	Disable
+1	1	Enable
+4	0	Fallback
+4	1	Normal
+6	0	Emergency
+6	1	Alert
+6	2	Critical
+6	3	Error
+6	4	Warning
+6	5	Notice
+6	6	Info
+6	7	Debug
+6	8	Spew
+7	0	Disable
+7	1	Enable
+7	2	Keep
+
+# -----------------------------------------------------------------
+checksums
+
+checksum 392 447 984
diff --git a/src/mainboard/asustek_computer/k53sc/mainboard.c b/src/mainboard/asustek_computer/k53sc/mainboard.c
index 6b46d2f857..1d13f98062 100644
--- a/src/mainboard/asustek_computer/k53sc/mainboard.c
+++ b/src/mainboard/asustek_computer/k53sc/mainboard.c
@@ -2,6 +2,9 @@
 
 #include <acpi/acpi.h>
 #include <device/device.h>
+#include <device/pci_def.h>
+#include <device/pci_ops.h>
+#include <option.h>
 #include <drivers/intel/gma/int15.h>
 #include <pc80/keyboard.h>
 
@@ -32,10 +35,40 @@ static void mainboard_init(struct device *dev)
 		k53sc_ec_enter_acpi_mode();
 }
 
+/*
+ * Allow the discrete GeForce GT 520MX to be switched off from firmware.
+ *
+ * Clearing the PEG10 device here is enough: sandybridge's disable_peg(), which
+ * runs later from northbridge_init(), sees the inactive bridge and clears
+ * DEVEN_PEG10. The port then disappears from PCI entirely rather than merely
+ * being hidden from the OS, so the GPU draws no power.
+ *
+ * Toggle it from a booted system with:
+ *   nvramtool -w dgpu=Disable    (or Enable), then reboot
+ */
+static void k53sc_configure_dgpu(void)
+{
+	struct device *peg;
+
+	if (get_uint_option("dgpu", 1))
+		return;
+
+	peg = pcidev_on_root(1, 0);
+	if (!peg) {
+		printk(BIOS_WARNING, "K53SC: PEG10 not found, cannot disable dGPU\n");
+		return;
+	}
+
+	peg->enabled = 0;
+	printk(BIOS_INFO, "K53SC: discrete GPU disabled via CMOS option\n");
+}
+
 static void mainboard_enable(struct device *dev)
 {
 	dev->ops->init = mainboard_init;
 
+	k53sc_configure_dgpu();
+
 	install_intel_vga_int15_handler(
 		GMA_INT15_ACTIVE_LFP_INT_LVDS,
 		GMA_INT15_PANEL_FIT_DEFAULT,
-- 
