Subject: [PATCH 02/23] mb/asustek_computer/k53sc: sanitize initial bring-up

---
 src/mainboard/asustek_computer/k53sc/Kconfig  |  8 ++--
 .../asustek_computer/k53sc/acpi/ec.asl        | 45 +++++++++++++++++--
 .../asustek_computer/k53sc/devicetree.cb      |  6 +--
 .../asustek_computer/k53sc/gma-mainboard.ads  | 12 +----
 .../asustek_computer/k53sc/mainboard.c        | 43 +++++-------------
 5 files changed, 60 insertions(+), 54 deletions(-)

diff --git a/src/mainboard/asustek_computer/k53sc/Kconfig b/src/mainboard/asustek_computer/k53sc/Kconfig
index e1c25af95d..c647c98fc7 100644
--- a/src/mainboard/asustek_computer/k53sc/Kconfig
+++ b/src/mainboard/asustek_computer/k53sc/Kconfig
@@ -7,10 +7,9 @@ config BOARD_SPECIFIC_OPTIONS
 	select AZALIA_USE_LEGACY_VERB_TABLE
 	select BOARD_ROMSIZE_KB_4096
 	select EC_ACPI
-	select HAVE_ACPI_RESUME
 	select HAVE_ACPI_TABLES
 	select INTEL_INT15
-	select MAINBOARD_HAS_LIBGFXINIT # FIXME: check this
+	select MAINBOARD_HAS_LIBGFXINIT
 	select NORTHBRIDGE_INTEL_SANDYBRIDGE
 	select SERIRQ_CONTINUOUS_MODE
 	select SOUTHBRIDGE_INTEL_BD82X6X
@@ -29,11 +28,12 @@ config VGA_BIOS_ID
 	string
 	default "8086,0116"
 
-config DRAM_RESET_GATE_GPIO # FIXME: check this
+config DRAM_RESET_GATE_GPIO
 	int
 	default 60
 
-config USBDEBUG_HCD_INDEX # FIXME: check this
+config USBDEBUG_HCD_INDEX
 	int
 	default 2
+
 endif
diff --git a/src/mainboard/asustek_computer/k53sc/acpi/ec.asl b/src/mainboard/asustek_computer/k53sc/acpi/ec.asl
index 45f704a776..5f30ed2026 100644
--- a/src/mainboard/asustek_computer/k53sc/acpi/ec.asl
+++ b/src/mainboard/asustek_computer/k53sc/acpi/ec.asl
@@ -1,9 +1,46 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
-Device(EC)
+Device (EC0)
 {
-	Name (_HID, EISAID("PNP0C09"))
+	Name (_HID, EISAID ("PNP0C09"))
 	Name (_UID, 0)
-	Name (_GPE, 27)
-/* FIXME: EC support */
+	Name (_GPE, 0x1B)
+
+	Name (_CRS, ResourceTemplate ()
+	{
+		IO (Decode16,
+			0x0062,
+			0x0062,
+			0x00,
+			0x01
+		)
+
+		IO (Decode16,
+			0x0066,
+			0x0066,
+			0x00,
+			0x01
+		)
+	})
+
+	Name (REGC, Zero)
+
+	Method (_REG, 2, NotSerialized)
+	{
+		If (Arg0 == 0x03)
+		{
+			REGC = Arg1
+		}
+	}
+
+	Method (ECAV, 0, NotSerialized)
+	{
+		Return (REGC)
+	}
+
+	/*
+	 * Deliberately no register fields or _Qxx methods yet.
+	 * Those will be reconstructed from observed ASUS behavior.
+	 */
+	OperationRegion (ERAM, EmbeddedControl, 0x00, 0xFF)
 }
diff --git a/src/mainboard/asustek_computer/k53sc/devicetree.cb b/src/mainboard/asustek_computer/k53sc/devicetree.cb
index 0cbbfb8e22..26f402aac5 100644
--- a/src/mainboard/asustek_computer/k53sc/devicetree.cb
+++ b/src/mainboard/asustek_computer/k53sc/devicetree.cb
@@ -11,19 +11,19 @@ chip northbridge/intel/sandybridge # FIXME: GPU registers may not always apply.
 	register "gpu_panel_power_down_delay" = "500"
 	register "gpu_panel_power_up_delay" = "600"
 	register "gpu_pch_backlight" = "0x13121312"
-	register "spd_addresses" = "{0x50, 0x51, 0x52, 0x53}" # FIXME: Put proper SPD map here"
+	register "spd_addresses" = "{0x50, 0x00, 0x52, 0x00}" # FIXME: Put proper SPD map here"
 	device domain 0x0 on
 		device ref host_bridge on
 			subsystemid 0x1043 0x1277
 		end
-		device ref peg10 on
+		device ref peg10 off
 			subsystemid 0x1043 0x1277
 		end
 		device ref igd on
 			subsystemid 0x1043 0x1682
 		end
 		chip southbridge/intel/bd82x6x # Intel 6 Series Cougar Point PCH
-			register "docking_supported" = "1"
+			register "docking_supported" = "0"
 			register "gen1_dec" = "0x00000000"
 			register "gen2_dec" = "0x00000000"
 			register "gen3_dec" = "0x002c0251"
