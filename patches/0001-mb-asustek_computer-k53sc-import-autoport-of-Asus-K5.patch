+	select USE_NATIVE_RAMINIT
+
+config MAINBOARD_DIR
+	string
+	default "asustek_computer/k53sc"
+
+config MAINBOARD_PART_NUMBER
+	string
+	default "K53SC"
+
+config VGA_BIOS_ID
+	string
+	default "8086,0116"
+
+config DRAM_RESET_GATE_GPIO # FIXME: check this
+	int
+	default 60
+
+config USBDEBUG_HCD_INDEX # FIXME: check this
